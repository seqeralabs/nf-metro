%%metro title: Same-destination short overlap tails
%%metro line: l0 | Zero | #e6194b
%%metro line: l1 | One | #3cb44b
%%metro line: l2 | Two | #4363d8
%%metro grid: top | 0,0
%%metro grid: src | 0,1
%%metro grid: target | 1,1
%%metro grid: sink | 2,1

graph LR
    subgraph top [Top]
        t[T]
    end
    subgraph src [Source]
        a[A]
    end
    subgraph target [Target]
        b[B]
        c[C]
        d[D]
        e[E]
        f[F]
        b -->|l1,l2| c
        c -->|l1,l2| d
        d -->|l2| e
        e -->|l2| f
    end
    subgraph sink [Sink]
        %%metro direction: RL
        z[Z]
        w[W]
        z -->|l1,l2| w
    end
    t -->|l0| b
    a -->|l1,l2| b
    d -->|l1| z
    f -->|l2| z
