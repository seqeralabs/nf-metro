%% Label-strike clearance grows several gap levers whose insertion order is
%% recorded in the settled graph without moving any drawn geometry.
%%metro style: seqera
%%metro line: l0 | Polish_Quant_Align | #e6194b
%%metro line: l1 | Cluster | #3cb44b
%%metro line: l2 | Stats_Report | #4363d8
%%metro line: l3 | Trim_Trim | #f58231

graph LR
    subgraph sec0 [Vcf 0]
        %%metro direction: TB
        s0n0[trim]
        s0n1[trim_bam_call]
        s0n2[align]
        s0n3[report_cluster]
        s0n0 -->|l1,l3| s0n1
        s0n1 -->|l1,l3| s0n2
        s0n2 -->|l3| s0n3
    end
    subgraph sec1 [Qc 1]
        s1n0[FASTQC_POLISH]
        s1n1[gather]
        s1n0 -->|l0| s1n1
    end
    subgraph sec2 [Dedup_Stats 2]
        s2n0[merge_align]
        s2n1[NORMALIZE]
        s2n2[fastqc]
        s2n0 -->|l0,l1| s2n2
        s2n0 -->|l0,l2,l3| s2n1
        s2n1 -->|l0,l3| s2n2
    end
    s1n1 -->|l0| s2n0
    s0n2 -->|l1| s2n0
    s1n0 -->|l2| s2n0
    s0n3 -->|l3| s2n0
    s0n0 -->|l3| s1n1
