%%metro title: TB fork to a perpendicular exit
%%metro style: seqera
%%metro line: l0 | Trim | #e6194b
%%metro line: l1 | Sort_Filter | #3cb44b
%%metro line: l2 | Align | #4363d8
%%metro line: l3 | Markdup | #f58231

graph LR
    subgraph sec0 [Gather 0]
        %%metro direction: TB
        s0n0[sort]
        s0n1[summarise]
        s0n0 -->|l1,l2,l3| s0n1
    end
    subgraph sec1 [Align 1]
        %%metro direction: BT
        s1n0[cluster]
        s1n1[gather]
        s1n2[markdup]
        s1n3[export_bin_count]
        s1n0 -->|l0,l3| s1n1
        s1n1 -->|l0,l3| s1n2
        s1n2 -->|l0,l1,l3| s1n3
        s1n0 -->|l1| s1n2
    end
    subgraph sec2 [Cluster_Bin_Stats 2]
        %%metro direction: TB
        s2n0[dedup_assemble]
        s2n1[export]
        s2n0 -->|l1,l2| s2n1
    end
    s0n1 -->|l0,l1,l3| s1n0
    s1n3 -->|l1| s2n0
    s0n1 -->|l2| s2n0
    s0n0 -->|l2| s1n3
    s0n1 -->|l3| s2n1
    s1n2 -->|l3| s2n1
