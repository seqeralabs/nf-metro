%%metro title: Line rejoining a run by its own path
%%metro style: seqera
%%metro line: l0 | Count | #e6194b
%%metro line: l1 | Polish | #3cb44b
%%metro line: l2 | Pca | #4363d8
%%metro line: l3 | Annotate | #f58231

graph LR
    subgraph sec0 [Dedup_Sort 0]
        %%metro direction: TB
        %%metro exit: top | l0, l1, l2
        s0n0[assemble_normalize]
        s0n1[assemble]
        s0n2[sort_stats]
        s0n3[QC_BIN_CLUSTER]
        s0n4[qc_trim_fastqc]
        s0n0 -->|l0| s0n1
        s0n0 -->|l1| s0n2
        s0n2 -->|l1| s0n3
        s0n3 -->|l1| s0n4
    end
    subgraph sec1 [Sort 1]
        s1n0[summarise_dedup_export]
        s1n1[classify_bin]
        s1n2[index]
        s1n0 -->|l0,l1| s1n1
        s1n1 -->|l0,l1| s1n2
    end
    subgraph sec2 [Qc_Normalize 2]
        s2n0[pca]
        s2n1[vcf]
        s2n2[FASTQC]
        s2n3[bin_index]
        s2n4[align]
        s2n0 -->|l0| s2n2
        s2n2 -->|l0| s2n3
        s2n3 -->|l0,l3| s2n4
        s2n0 -->|l1| s2n4
        s2n0 -->|l3| s2n1
        s2n1 -->|l3| s2n3
    end
    s0n1 -->|l0| s1n0
    s1n2 -->|l0,l1,l3| s2n0
    s0n4 -->|l1| s1n0
    s0n4 -->|l1| s2n3
    s0n2 -->|l2| s1n0
    s0n2 -->|l2| s2n2
    s1n2 -->|l3| s2n2
