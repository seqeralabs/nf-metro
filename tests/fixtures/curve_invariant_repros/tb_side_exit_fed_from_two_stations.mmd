%%metro line: l1 | Line 2 | #6ef362
%%metro line: l2 | Line 3 | #a66d13
%%metro line: l3 | Line 4 | #156075
graph LR
    subgraph a [A]
        %%metro direction: TB
        a0[A0]
        a1[A1]
        a2[A2]
        a0 -->|l3| a1
