        %%metro entry: top | l0, l1, l2, l4
        s2n0 -->|l0,l1,l4| s2n1
        s2n1 -->|l0| s2n3
    end
    subgraph sec3 [Classify]
        %%metro direction: TB
        %%metro entry: top | l2, l3, l4
        s3n0 -->|l2,l3,l4| s3n1
        s3n2 -->|l4| s3n3
    end
    s0n4 -->|l0,l2,l3,l4| s1n0
    s0n4 -->|l1| s2n0
    s1n4 -->|l2| s3n0
    s0n4 -->|l2| s2n3
    s2n3 -->|l2| s3n3
    s1n1 -->|l3| s3n0
    s1n2 -->|l4| s2n0
    s2n3 -->|l4| s3n0
