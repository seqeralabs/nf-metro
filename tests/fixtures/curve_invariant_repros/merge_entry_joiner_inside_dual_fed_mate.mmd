%%metro line: m1 | L1 | #3cb44b
%%metro line: m2 | L2 | #4363d8

graph LR
    subgraph z0 [Zone 0]
        q0x0[Q0X0]
        q0x1[Q0X1]
        q0x2[Q0X2]
        q0x0 -->|m0,m1| q0x1
        q0x1 -->|m0,m1| q0x2
    end
    subgraph z1 [Zone 1]
        %%metro direction: TB
        q1x0[Q1X0]
        q1x1[Q1X1]
        q1x2[Q1X2]
        q1x0 -->|m0| q1x1
        q1x0 -->|m2| q1x2
        q1x1 -->|m0,m1| q1x2
    end
    subgraph z2 [Zone 2]
        q2x0[Q2X0]
        q2x1[Q2X1]
        q2x2[Q2X2]
        q2x0 -->|m0,m1,m2| q2x1
        q2x1 -->|m1,m2| q2x2
    end
    q0x2 -->|m0,m2| q1x0
    q0x2 -->|m1| q2x0
    q1x1 -->|m2| q2x0
