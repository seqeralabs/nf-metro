%%metro line: b | B | #4363d8
%%metro grid: f | 0,0
%%metro grid: m | 1,0
%%metro grid: d | 2,0

graph LR
    subgraph f [Feed]
        %%metro direction: LR
        f0[F0]
        f1[F1]
        f0 -->|r| f1
    end
    subgraph m [Merge]
        %%metro direction: LR
        a[A]
        b1[B1]
        c1[C1]
        mm[M]
        z[Z]
        a -->|r| mm
        b1 -->|g| mm
        c1 -->|b| mm
        mm -->|r,g,b| z
    end
    subgraph d [Down]
        %%metro direction: LR
        d0[D0]
        d1[D1]
        d0 -->|r,g,b| d1
    end
    f1 -->|r| a
    z -->|r,g,b| d0
