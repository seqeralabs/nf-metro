    "layout": {
      "type": "object",
      "properties": {
        "x_spacing": {
          "description": "Horizontal spacing between layers.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y_spacing": {
          "description": "Vertical spacing between tracks.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "section_x_gap": {
          "description": "Horizontal gap between sections.",
          "type": "number",
          "minimum": 0
        },
        "section_y_gap": {
          "description": "Vertical gap between sections.",
          "type": "number",
          "minimum": 0
        },
        "section_x_padding": {
          "description": "Space between a section's box and its stations along x.",
          "type": "number",
          "minimum": 0
        },
        "section_y_padding": {
          "description": "Space between a section's box and its stations along y.",
          "type": "number",
          "minimum": 0
        },
        "track_gap": {
          "description": "Gap in px between adjacent strokes in a bundle.",
          "type": "number",
          "minimum": 0,
          "maximum": 3.0
        },
        "diamond_style": {
          "description": "Fork-join (diamond) branch layout.",
          "enum": [
            "straight",
            "symmetric"
          ]
        },
        "line_order": {
          "description": "Track assignment order for lines.",
          "enum": [
            "definition",
            "span"
          ]
        },
        "row_align": {
          "description": "Section bbox sizing within a grid row.",
          "enum": [
            "content",
            "top"
          ]
        },
        "center_ports": {
          "description": "Centre inter-section ports on the shorter section.",
          "type": "boolean"
        },
        "compact_offsets": {
          "description": "Size each station for the lines passing through it.",
          "type": "boolean"
        },
        "label_angle": {
          "description": "Station label angle in degrees (0 = horizontal).",
          "type": "number"
        },
        "label_offset": {
          "description": "Gap between a station marker and its label.",
          "type": "number",
          "minimum": 0
        },
        "diagonal_run": {
          "description": "Length of the 45-degree transition between two tracks.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "curve_radius_ratio": {
          "description": "Corner radius at the line centre, in multiples of the line width.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "font_scale": {
          "description": "Scale text sizes and label metrics.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stroke_scale": {
          "description": "Scale stroke weight and station pill size.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "logo_scale": {
          "description": "Scale the logo, in the legend block or standalone.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "legend_min_height": {
          "description": "Minimum legend content height in px.",
          "type": "number",
          "minimum": 0
        },
        "legend_logo_gap": {
          "description": "Gap in px between the logo and the legend entries.",
          "type": "number",
          "minimum": 0
        },
        "directional": {
          "description": "Draw chevrons showing each route's flow direction.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Layout options, below `%%metro` directives and command-line flags."
    },
