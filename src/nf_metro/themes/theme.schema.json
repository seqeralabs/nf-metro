{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/seqeralabs/nf-metro/main/src/nf_metro/themes/theme.schema.json",
  "title": "nf-metro theme",
  "description": "A theme file: top-level fields apply to both palettes, `light:` and `dark:` colours to one each.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "\\S",
      "description": "Theme name."
    },
    "extends": {
      "description": "Themes stacked before this one: a name, a theme file relative to this file, or a list of them.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
