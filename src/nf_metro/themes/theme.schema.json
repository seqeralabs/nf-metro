  "additionalProperties": false,
  "$defs": {
    "fields": {
      "background_fill": {
        "description": "Canvas fill. `none` leaves the canvas transparent.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
        "x-colour": true
      },
      "title_color": {
        "description": "Map title text.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
        "x-colour": true
      },
      "title_font_size": {
        "description": "Map title size, px.",
        "x-group": "Canvas and text",
        "type": "number",
        "minimum": 0
      },
      "title_font_weight": {
        "description": "Map title weight.",
        "x-group": "Canvas and text",
        "enum": [
          "normal",
          "bold",
          "bolder",
          "lighter",
          "100",
          "200",
          "300",
          "400",
          "500",
          "600",
          "700",
          "800",
          "900"
        ],
        "default": "bold"
      },
      "label_color": {
        "description": "Station label text.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
        "x-colour": true
      },
      "label_font_family": {
        "description": "CSS font stack for station labels, and for every other text element.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^[\\w\\s,'.-]+$"
      },
      "label_font_size": {
        "description": "Station label size, px.",
        "x-group": "Canvas and text",
        "type": "number",
        "minimum": 0
      },
      "label_font_weight": {
        "description": "Station label weight (`bold`, `normal`, `600`, ...).",
        "x-group": "Canvas and text",
        "enum": [
          "normal",
          "bold",
          "bolder",
          "lighter",
          "100",
          "200",
          "300",
          "400",
          "500",
          "600",
          "700",
          "800",
          "900"
        ]
      },
      "label_halo_width": {
        "description": "Width of the knockout halo behind station labels, px. 0 disables it.",
        "x-group": "Canvas and text",
        "type": "number",
        "minimum": 0,
        "default": 3.0
      },
      "knockout_fill": {
        "description": "Halo behind station labels and the inside of `open` markers. Empty takes the background, or white on a transparent canvas.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
        "x-colour": true,
        "default": ""
      },
      "caption_color": {
        "description": "`%%metro caption:` text.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
        "x-colour": true,
        "default": "rgba(200, 200, 200, 0.85)"
      },
      "caption_font_size": {
        "description": "Caption size, px.",
        "x-group": "Canvas and text",
        "type": "number",
        "minimum": 0,
        "default": 11
      },
      "watermark_color": {
        "description": "The attribution line.",
        "x-group": "Canvas and text",
        "type": "string",
        "pattern": "^\\s*(|none|transparent|currentColor|#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(?:rgb|rgba|hsl|hsla)\\(\\s*[-0-9.%,\\s/]+\\)|[a-zA-Z]+)\\s*$",
