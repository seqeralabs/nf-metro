---
import { join } from "node:path";
import { Code } from "@astrojs/starlight/components";
import ZoomableSVG from "@components/ZoomableSVG.astro";
import { renderMetroBinary, REPO_ROOT } from "../lib/render-metro.mjs";
import { base } from "../site";

// One primitive for every nf-metro map in the docs. It renders up to three
// uniformly-framed sections for a committed `.mmd` source - the Mermaid source,
// the CLI command, and the live map - at build time (no pre-generated SVGs).
//
// `purpose` is a shorthand that sets all three at once for a common intent;
// the `mmd` / `command` / `render` props override individual sections. Each
// section state is "open" (shown, expanded), "collapsed" (shown, folded), or
// false (hidden).
//
// `clean` bypasses all sections and outputs just the rendered map - wrapped in
// ZoomableSVG for the default `format="svg"`, or a bare <img>/<video> for one
// of the raster/looping-video formats - for embedding directly in a hero or
// other contexts that need the map without any <details> chrome. Ignores
// purpose/mmd/command/render.
//
// The rendered SVG arrives through the `?metro` Vite plugin as an imported
// module string. Importing it (rather than rendering to a runtime string and
// using set:html) is what lets its `light-dark()` chrome follow the page theme
// and keeps its embedded `<image>` logo through the production HTML build.
//
// A non-svg `format` instead calls `renderMetroBinary` directly: its output
// can't be inlined, so it's written once to a static file and referenced by
// URL - see that function's own doc comment for why this doesn't need the
// Vite plugin's module-graph trick the inline SVG path relies on.

type SectionState = "open" | "collapsed" | false;
type MetroFormat = "svg" | "png" | "gif" | "webp" | "mp4" | "webm";
const PLAYS_IN_VIDEO_TAG = new Set<MetroFormat>(["mp4", "webm"]);

interface Props {
  // Repo-relative path to the source, e.g. "examples/guide/01_minimal.mmd".
  src: string;
  // Intent preset for the three sections (overridden by the per-section props).
  //   teach     - source + map open, no command (the default; guide examples).
  //   showcase  - map open, source and command available but folded (gallery).
  //   reference - command + map open, source folded.
  purpose?: "teach" | "showcase" | "reference";
  // Per-section overrides.
  mmd?: SectionState;
  command?: SectionState;
  render?: SectionState;
  // Render with the --debug layout overlay.
  debug?: boolean;
  // Treat the source as a Nextflow DAG and convert it (--from-nextflow).
  fromNextflow?: boolean;
  // Output format. "svg" (default) keeps the inline, theme-following render;
  // "png" and the four looping-video formats render live via nf-metro and
  // are embedded as a static <img>/<video>.
  format?: MetroFormat;
  // Add the --animate balls. Forced on regardless for a video format; set
  // this alongside format="svg" for an animated (but not looping-exported) map.
  animate?: boolean;
  // Video formats only: --duration and --fps for the exported loop.
  duration?: number;
  fps?: number;
  // Raster/video formats only: --scale / --raster-width, sizing the export
  // the same way they size a PNG.
  scale?: number;
  rasterWidth?: number;
  // <Code> title for the source block, and the alt text base for a raster/
  // video render; defaults to the src path.
  title?: string;
  // Output only the rendered map - a ZoomableSVG for format="svg", or a bare
  // <img>/<video> otherwise; no <details> chrome. Ignores
  // purpose/mmd/command/render. For hero and embed contexts.
  clean?: boolean;
}

const PURPOSES: Record<
  NonNullable<Props["purpose"]>,
  { mmd: SectionState; command: SectionState; render: SectionState }
> = {
  teach: { mmd: "open", command: false, render: "open" },
  showcase: { mmd: "collapsed", command: "collapsed", render: "open" },
  reference: { mmd: "collapsed", command: "open", render: "open" },
};

const {
  src,
  purpose = "teach",
  mmd,
  command,
  render,
  debug = false,
  fromNextflow = false,
  format = "svg",
  animate = false,
  duration,
  fps,
  scale,
  rasterWidth,
  title,
  clean = false,
} = Astro.props;

const isBinary = format !== "svg";

const preset = PURPOSES[purpose];
const mmdState = clean ? false : (mmd ?? preset.mmd);
const commandState = clean ? false : (command ?? preset.command);
const renderState = clean ? "open" : (render ?? preset.render);

if (fromNextflow && debug) {
  // No combined `?metro&nextflow&debug` glob exists; fail loudly rather than
  // silently render one mode and drop the other.
  throw new Error(
    `<Metro src="${src}">: \`debug\` and \`fromNextflow\` cannot be combined.`,
  );
}
if (animate && (debug || fromNextflow) && !isBinary) {
  // Same reasoning: no combined `?metro&animate&{debug,nextflow}` glob exists.
  throw new Error(
    `<Metro src="${src}">: \`animate\` cannot be combined with \`debug\` or \`fromNextflow\`.`,
  );
}

// Committed source files live one level above the Astro project. Each glob is
// scoped to what its render mode can consume, so the build only shells out to
// nf-metro for maps a page can actually request:
//   - raw source: any committed .mmd (cheap, just text).
//   - plain render: metro maps under examples/ and the top-level test fixtures
//     (NOT tests/fixtures/nextflow, whose DAGs are not valid metro).
//   - debug overlay: only examples/ and examples/guide/, never examples/topologies/.
//   - animated: same scope as debug.
//   - Nextflow conversion: only the DAG fixtures.
//
// A build resolves every module a glob can reach, whether or not any page's
// `resolve()` call ever looks it up - so debug/animate deliberately exclude
// examples/topologies/ (~280 fixtures) rather than reusing the "examples/**"
// pattern the plain render uses.
const rawSources = {
  ...import.meta.glob("../../../examples/**/*.mmd", { query: "?raw", import: "default" }),
  ...import.meta.glob("../../../tests/fixtures/**/*.mmd", { query: "?raw", import: "default" }),
};
const svgSources = {
  ...import.meta.glob("../../../examples/**/*.mmd", { query: "?metro", import: "default" }),
  ...import.meta.glob("../../../tests/fixtures/*.mmd", { query: "?metro", import: "default" }),
};
const svgDebugSources = {
  ...import.meta.glob("../../../examples/*.mmd", { query: "?metro&debug", import: "default" }),
  ...import.meta.glob("../../../examples/guide/*.mmd", { query: "?metro&debug", import: "default" }),
};
const svgAnimateSources = {
  ...import.meta.glob("../../../examples/*.mmd", { query: "?metro&animate", import: "default" }),
  ...import.meta.glob("../../../examples/guide/*.mmd", { query: "?metro&animate", import: "default" }),
};
const svgNextflowSources = import.meta.glob(
  "../../../tests/fixtures/nextflow/**/*.mmd",
  { query: "?metro&nextflow", import: "default" },
);

// Each render mode pairs its source map with the scope named in the not-found
// error, so the selection and the message can't drift apart.
type Sources = Record<string, () => Promise<unknown>>;
const RENDER_MODES: Record<string, { mods: Sources; scope: string }> = {
  plain: {
    mods: svgSources,
    scope: "examples/** and tests/fixtures/*.mmd (top level only)",
  },
  debug: { mods: svgDebugSources, scope: "examples/*.mmd and examples/guide/*.mmd" },
  animate: { mods: svgAnimateSources, scope: "examples/*.mmd and examples/guide/*.mmd" },
  nextflow: { mods: svgNextflowSources, scope: "tests/fixtures/nextflow/**" },
};
const renderMode = fromNextflow ? "nextflow" : debug ? "debug" : animate ? "animate" : "plain";

const key = `../../../${src}`;

function resolve(mods: Sources, what: string, scope: string) {
  const loader = mods[key];
  if (!loader) {
    throw new Error(
      `<Metro src="${src}">: no ${what} found. Globbed: ${scope}. ` +
        `If this is a .mmd in a new subdirectory, extend the matching glob in Metro.astro.`,
    );
  }
  return loader();
}

const source =
  mmdState !== false
    ? ((await resolve(
        rawSources,
        "source",
        "examples/** and tests/fixtures/**",
      )) as string)
    : null;

let svg: string | null = null;
let mediaUrl: string | null = null;
if (renderState !== false) {
  if (isBinary) {
    const { path } = renderMetroBinary(join(REPO_ROOT, src), {
      format,
      debug,
      fromNextflow,
      animate,
      duration,
      fps,
      scale,
      rasterWidth,
    });
    mediaUrl = `${base}${path}`;
  } else {
    const { mods: renderMods, scope: renderScope } = RENDER_MODES[renderMode];
    svg = (await resolve(renderMods, "render", renderScope)) as string;
  }
}

const stem = src.split("/").pop()?.replace(/\.mmd$/, "") ?? "map";
let cliCommand = `nf-metro render ${src} -o ${stem}.${format}`;
if (debug) cliCommand += " --debug";
if (fromNextflow) cliCommand += " --from-nextflow";
if (animate && !isBinary) cliCommand += " --animate";
if (duration != null) cliCommand += ` --duration ${duration}`;
if (fps != null) cliCommand += ` --fps ${fps}`;
if (scale != null) cliCommand += ` --scale ${scale}`;
if (rasterWidth != null) cliCommand += ` --raster-width ${rasterWidth}`;
const codeTitle = title ?? src;
---

{
  clean ? (
    isBinary ? (
      PLAYS_IN_VIDEO_TAG.has(format) ? (
        <video controls autoplay loop muted playsinline class="metro-media" src={mediaUrl}>
          Your browser can't play the embedded video.
          <a href={mediaUrl}>Download it here</a>.
        </video>
      ) : (
        <img
          src={mediaUrl}
          alt={`${codeTitle} rendered as ${format.toUpperCase()}`}
          loading="lazy"
          class="metro-media"
        />
      )
    ) : (
      <ZoomableSVG>
        <Fragment set:html={svg} />
      </ZoomableSVG>
    )
  ) : (
    <div class="metro">
      {
        mmdState !== false && (
          <details class="metro-part" open={mmdState === "open"}>
            <summary>Mermaid source</summary>
            <Code code={source} lang="metro" title={codeTitle} />
          </details>
        )
      }
      {
        commandState !== false && (
          <details class="metro-part" open={commandState === "open"}>
            <summary>CLI command</summary>
            <Code code={cliCommand} lang="bash" />
          </details>
        )
      }
      {
        renderState !== false && (
          <details class="metro-part metro-render" open={renderState === "open"}>
            <summary>Rendered map</summary>
            {
              isBinary ? (
                PLAYS_IN_VIDEO_TAG.has(format) ? (
                  <video
                    controls
                    autoplay
                    loop
                    muted
                    playsinline
                    class="metro-media"
                    src={mediaUrl}
                  >
                    Your browser can't play the embedded video.
                    <a href={mediaUrl}>Download it here</a>.
                  </video>
                ) : (
                  <img
                    src={mediaUrl}
                    alt={`${codeTitle} rendered as ${format.toUpperCase()}`}
                    loading="lazy"
                    class="metro-media"
                  />
                )
              ) : (
                <ZoomableSVG>
                  <Fragment set:html={svg} />
                </ZoomableSVG>
              )
            }
          </details>
        )
      }
    </div>
  )
}

<style>
  /* The three sections inherit Starlight's native <details> styling (the
     full-height left accent bar + rotating chevron marker); this only spaces
     them apart, since they are nested in a wrapper rather than direct children
     of the markdown content. */
  .metro {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 1rem 0;
  }
  .metro-media {
    width: 100%;
    display: block;
    border-radius: 6px;
  }
</style>
