%%metro title: Same-Row Bypass Joins a Flat Bundle
%%metro style: dark
%%metro line: main | Main | #e63946
%%metro line: qc | QC | #2db572
%%metro line: skip | Skip | #f5c542
%%metro line: aux | Aux | #0570b0
%%metro line: side | Side | #9b59b6
%%metro grid: ingest | 0,0
%%metro grid: side_step | 1,0
%%metro grid: process | 2,0
%%metro grid: report | 3,0

graph LR
    subgraph ingest [Ingest]
        load[Load]
        split[Split]
        load -->|skip,side| split
    end

    subgraph side_step [Side Step]
        annotate[Annotate]
        filter[Filter]
        annotate -->|side| filter
    end

    subgraph process [Process]
        align[Align]
        quant[Quantify]
        align -->|main,qc,aux| quant
    end

    subgraph report [Report]
        summary[Summary]
    end

    split -->|side| annotate
    split -->|skip| summary
    quant -->|main,qc,aux| summary
