%%metro title: Over-Top Fan Reach Order
%%metro style: dark
%%metro line: l0 | L0 | #e6194b
%%metro line: l1 | L1 | #3cb44b
%%metro line: l2 | L2 | #4363d8

graph LR
    subgraph a [A]
        a0[A0]
    end
    subgraph b [B]
        %%metro entry: top | l0
        b0[B0]
        b1[B1]
        b2[B2]
        b0 -->|l2| b1
        b1 -->|l2| b2
    end
    subgraph c [C]
        %%metro entry: right | l1, l2
        c0[C0]
        c1[C1]
        c0 -->|l2| c1
    end
    a0 -->|l0| b0
    a0 -->|l1| c0
    b2 -->|l2| c0
