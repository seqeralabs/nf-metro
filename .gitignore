__pycache__/
*.pyc
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
.env
site/

# uv.lock is committed: the project is uv-native and CI resolves with --frozen.

# Generated docs content (scripts/build_gallery.py): SVGs + content collection manifests.
# docs/ holds the hand-written markdown; the Astro site in website/ symlinks it.
docs/assets/renders/
website/src/content/gallery.json
website/src/content/pipelines.json

# Build-time SVG render cache for the remark-metro docs plugin.
website/.metro-cache/

# Build-time raster/video exports for <Metro format="..."> (render-metro.mjs).
website/public/_generated/

# Root-level node_modules if prettier or other npm tools are run at repo root.
node_modules/
package-lock.json

# Claude Code per-session scratch state (prompts, locks, worktrees)
.claude/prompts/
.claude/scheduled_tasks.lock
.claude/worktrees/
.coverage

# Intermediate per-revision geometry vectors (regenerate with datasets/layout_preferences/scripts/replay.py)
datasets/layout_preferences/scripts/geometry/
datasets/layout_preferences/geometry_vectors.tar.gz

# Nextflow run state left behind by a local `examples/live/` demo run
# (e.g. the live-demo-video skill)
work/
.nextflow/
.nextflow.log
